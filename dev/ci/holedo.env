NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=holedo_crm
DB_USER=holedo_crm
DB_PASSWORD=local-holedo-crm-password
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=local-postgres-password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

AUTH_MODE=oidc
OIDC_ISSUER_URL=http://localhost:8080/realms/holedo-local
OIDC_CLIENT_ID=holedo-crm
OIDC_CLIENT_SECRET=local-holedo-crm-secret
OIDC_ALLOW_INSECURE_HTTP=true
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
PLATFORM_ADMIN_ROLE=holedo-platform-admin

SESSION_SECRET=local-ci-session-secret-not-for-production-123456789
SESSION_MAX_AGE_SECONDS=43200
ALLOW_SELF_SERVICE_COMPANY_WORKSPACES=true
ADMIN_EMAIL=service@holedo.email
ADMIN_TOKEN=local-holedo-admin-token
ADMIN_SESSION_SECRET=local-holedo-admin-session-secret-123456789

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=holedo-crm-ci
S3_ACCESS_KEY_ID=holedo-crm
S3_SECRET_ACCESS_KEY=local-holedo-storage-secret
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
S3_SIGNED_URL_TTL_SECONDS=300
FILE_UPLOAD_LIMIT=10mb

KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin
KEYCLOAK_TEST_USER_EMAIL=crm.owner@local.holedo.test
KEYCLOAK_TEST_USER_PASSWORD=local-holedo-owner
KEYCLOAK_TEST_COLLEAGUE_EMAIL=crm.colleague@local.holedo.test
KEYCLOAK_TEST_COLLEAGUE_PASSWORD=local-holedo-colleague
