# Docker image and local reverse-proxy binding
HOLEDO_CRM_IMAGE=ghcr.io/hospitalityleaders/atomic-crm:latest
HOLEDO_CRM_BIND_ADDRESS=127.0.0.1
HOLEDO_CRM_PORT=3000

# Public application address
APP_ORIGIN=https://crm.holedo.com
TRUST_PROXY=1

# UpCloud Managed PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=holedo_crm
DB_USER=
DB_PASSWORD=
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Holedo Keycloak
OIDC_ISSUER_URL=https://identity.holedo.com/realms/holedo
OIDC_CLIENT_ID=holedo-crm
OIDC_CLIENT_SECRET=
OIDC_ALLOW_INSECURE_HTTP=false
OIDC_REDIRECT_URI=https://crm.holedo.com/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://crm.holedo.com/
PLATFORM_ADMIN_ROLE=holedo-platform-admin

# Session security
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=43200
SESSION_COOKIE_DOMAIN=

# Workspace policy
ALLOW_SELF_SERVICE_COMPANY_WORKSPACES=false

# Private S3-compatible object storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=holedo-crm
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_CREATE_BUCKET=false
S3_SIGNED_URL_TTL_SECONDS=300
FILE_UPLOAD_LIMIT=10mb
