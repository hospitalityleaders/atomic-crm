NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=holedo_crm
DB_SCHEMA=public
DB_USER=holedo_crm
DB_PASSWORD=change-me
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=change-me-too
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

AUTH_MODE=oidc
OIDC_ISSUER_URL=http://localhost:8080/realms/holedo-local
OIDC_CLIENT_ID=holedo-crm
OIDC_CLIENT_SECRET=local-holedo-crm-secret
OIDC_ALLOW_INSECURE_HTTP=true
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
SESSION_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
SESSION_MAX_AGE_SECONDS=43200
SESSION_COOKIE_DOMAIN=

ALLOW_SELF_SERVICE_COMPANY_WORKSPACES=true
PLATFORM_ADMIN_ROLE=holedo-platform-admin
ADMIN_EMAIL=service@holedo.email
ADMIN_TOKEN=replace-with-a-local-admin-token
ADMIN_SESSION_SECRET=replace-with-a-separate-admin-session-secret

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=holedo-crm-local
S3_ACCESS_KEY_ID=holedo-crm
S3_SECRET_ACCESS_KEY=replace-with-a-local-secret
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
S3_SIGNED_URL_TTL_SECONDS=300
FILE_UPLOAD_LIMIT=10mb

KEYCLOAK_TEST_USER_EMAIL=crm.owner@local.holedo.test
KEYCLOAK_TEST_USER_PASSWORD=replace-locally
KEYCLOAK_TEST_COLLEAGUE_EMAIL=crm.colleague@local.holedo.test
KEYCLOAK_TEST_COLLEAGUE_PASSWORD=replace-locally
